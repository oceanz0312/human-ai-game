# Game service (Next.js). OPENAI_API_KEY must never be set here; only the Cloudflare Worker holds it.
DECISIONS_WORKER_URL=https://human-ai-decisions.<account>.workers.dev
DECISIONS_WORKER_SHARED_SECRET=replace-with-at-least-32-random-bytes
# worker | fake | off. Defaults to worker when DECISIONS_WORKER_URL is set, fake in development, off otherwise.
DECISIONS_MODE=
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
# Signs the anonymous player cookie and poster URLs.
RESULT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Public origin used in share links and QR codes.
PUBLIC_BASE_URL=http://localhost:3000
