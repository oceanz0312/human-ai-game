{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "human-ai-decisions",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Placement hint: execute fetch handlers near OpenAI (US egress), not the player's edge POP.
  // Without this, browser decide-ticket runs in-country and OpenAI returns HTTP 403 unsupported_country_region_territory.
  // Alternative aligned with D1 WNAM: { "mode": "targeted", "region": "aws:us-west-2" }.
  "placement": { "mode": "targeted", "hostname": "api.openai.com" },
  "workers_dev": true,
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_DECISIONS_MODEL": "gpt-6-luna",
    "OPENAI_DECISIONS_TIMEOUT_MS": "8000",
    "PUBLIC_BASE_URL": "https://human-ai.zdychanges.workers.dev"
  },
  "services": [{ "binding": "GAME", "service": "human-ai" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "human-ai", "database_id": "2cb1e22d-8042-4045-b5eb-e8b1131e6925", "migrations_dir": "../../drizzle" }
  ],
  // Secrets: wrangler secret put OPENAI_API_KEY / DECISIONS_WORKER_SHARED_SECRET (never commit values here).
  "env": {
    "preview": {
      "name": "human-ai-decisions-preview",
      "placement": { "mode": "targeted", "hostname": "api.openai.com" },
      "vars": {
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_DECISIONS_MODEL": "gpt-6-luna",
        "OPENAI_DECISIONS_TIMEOUT_MS": "8000",
        "PUBLIC_BASE_URL": "https://human-ai.zdychanges.workers.dev"
      },
      "services": [{ "binding": "GAME", "service": "human-ai" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "human-ai", "database_id": "2cb1e22d-8042-4045-b5eb-e8b1131e6925", "migrations_dir": "../../drizzle" }
      ]
    }
  }
}
