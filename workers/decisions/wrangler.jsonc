{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "human-ai-decisions",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Belt-and-suspenders near WNAM; OpenAI calls are proxied via GAME (see handover.md). Placement alone did not fix CN egress.
  "placement": { "mode": "targeted", "region": "aws:us-west-2" },
  "workers_dev": true,
  "vars": {
    "PUBLIC_BASE_URL": "https://human-ai.zdychanges.workers.dev"
  },
  "services": [{ "binding": "GAME", "service": "human-ai" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "human-ai", "database_id": "2cb1e22d-8042-4045-b5eb-e8b1131e6925", "migrations_dir": "../../drizzle" }
  ],
  // Secrets: wrangler secret put DECISIONS_WORKER_SHARED_SECRET only (OpenAI key lives on human-ai).
  "env": {
    "preview": {
      "name": "human-ai-decisions-preview",
      "placement": { "mode": "targeted", "region": "aws:us-west-2" },
      "vars": {
        "PUBLIC_BASE_URL": "https://human-ai.zdychanges.workers.dev"
      },
      "services": [{ "binding": "GAME", "service": "human-ai" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "human-ai", "database_id": "2cb1e22d-8042-4045-b5eb-e8b1131e6925", "migrations_dir": "../../drizzle" }
      ]
    }
  }
}
