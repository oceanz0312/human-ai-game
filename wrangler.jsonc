{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Game service (Next.js via OpenNext). The Decisions gateway lives in workers/decisions/wrangler.jsonc.
  "name": "human-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Co-locate the Worker with D1 (WNAM) to cut cross-region database latency for API handlers.
  "workers_dev": true,
  // Canonical domain (zone spotthedifferencegame.com, same account). www 301s to the apex and workers.dev 301s
  // to the apex in next.config.ts redirects.
  "routes": [
    { "pattern": "spotthedifferencegame.com", "custom_domain": true },
    { "pattern": "www.spotthedifferencegame.com", "custom_domain": true }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "human-ai" },
    { "binding": "DECISIONS", "service": "human-ai-decisions" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "human-ai", "database_id": "2cb1e22d-8042-4045-b5eb-e8b1131e6925", "migrations_dir": "drizzle" }
  ],
  "vars": {
    // simulated = in-game AI opponent, no model calls (SEO plan 2026-10-18). Set "live" to re-enable the Decisions chain below.
    "AI_MODE": "simulated",
    // Simulated-AI difficulty curve (src/config/ai-difficulty.ts). "v1" = pre-2026-10-18 curve (kill switch).
    // Optional SIM_AI_DIFFICULTY_JSON overrides the v2 numbers without a code change (invalid JSON → defaults).
    "SIM_AI_CURVE": "v2",
    "DECISIONS_MODE": "worker",
    "DECISIONS_WORKER_URL": "https://human-ai-decisions.zdychanges.workers.dev",
    "PUBLIC_BASE_URL": "https://spotthedifferencegame.com",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_DECISIONS_MODEL": "gpt-6-luna",
    "OPENAI_DECISIONS_TIMEOUT_MS": "8000"
  }
  // Secrets: wrangler secret put DECISIONS_WORKER_SHARED_SECRET / RESULT_SIGNING_SECRET / OPENAI_API_KEY (never commit values here).
}
