{
  "name": "human-vs-ai-vision-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "build": "npm run levels:validate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --config workers/decisions/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit -p workers/decisions/tsconfig.json",
    "worker:deploy:preview": "wrangler deploy --env preview --config workers/decisions/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/decisions/wrangler.jsonc",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:db:migrate": "wrangler d1 migrations apply human-ai --remote",
    "levels:generate": "tsx scripts/generate-levels.ts",
    "levels:validate": "tsx scripts/validate-levels.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "og:generate": "node scripts/generate-og.mjs",
    "share:samples": "node scripts/render-share-samples.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "stats:d1": "node scripts/d1-stats.mjs",
    "printables:generate": "tsx scripts/generate-printables.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "modqr": "^1.0.4",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "26.1.0",
    "patch-package": "8.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "webidl-conversions": "^7.0.0"
  }
}
