# Cloudflare Workers Static Assets response headers (the Worker does not run for these files).
# Hashed build output never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Level art lives under a versioned directory (v1); keep a day fresh, serve stale while revalidating.
/levels/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=604800
/icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/apple-icon.png
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Printable PDFs (regenerated by `npm run printables:generate`, URL stays the same).
/printables/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
